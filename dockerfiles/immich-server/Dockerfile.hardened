ARG APP_VERSION="release"

FROM ghcr.io/immich-app/immich-server:${APP_VERSION}

USER root

ARG APP_VERSION
LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.source="https://github.com/Charlotte-de-R/hardening"
LABEL org.opencontainers.image.description="Immich Server - Photo/Video Backup (hardened & CVE-reduced)"

ENV DEBIAN_FRONTEND=noninteractive

# =========================
# Hardening Strategy 1: OS更新 + 不要パッケージ削除
# =========================
RUN apt-get update && \
    apt-get dist-upgrade -y && \
    (apt-get install -y --no-install-recommends --only-upgrade \
        libexpat1 \
        libxml2 \
        libopenexr31 \
        zlib1g \
        libsqlite3-0 \
        openssl \
        libglib2.0-0 \
        perl \
        perl-base || true) && \
    apt-get purge -y \
        perl-modules || true && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# =========================
# Hardening Strategy 2: protobufjs & proxy-addr 脆弱性の外科的置換
# =========================
WORKDIR /usr/src/app/server

RUN mkdir -p /tmp/patch && \
    cd /tmp/patch && \
    npm init -y && \
    npm install protobufjs@7.5.5 && \
    find /usr/src/app/server/node_modules -type d -name "protobufjs" -prune > /tmp/protobufjs_dirs.txt && \
    COUNT=$(wc -l < /tmp/protobufjs_dirs.txt) && \
    if [ "$COUNT" -eq 0 ]; then echo "Error: No protobufjs instance found to patch."; exit 1; fi && \
    while IFS= read -r dir; do \
        rm -rf "$dir" && cp -a /tmp/patch/node_modules/protobufjs "$dir"; \
    done < /tmp/protobufjs_dirs.txt && \
    rm -rf /tmp/patch /tmp/protobufjs_dirs.txt

# ★ proxy-addr を 2.0.8 (CVE-2026-90711 対策) に外科的置換
RUN mkdir -p /tmp/patch-proxy && cd /tmp/patch-proxy && \
    npm init -y && \
    npm install proxy-addr@2.0.8 && \
    find /usr/src/app/server/node_modules -type d -name "proxy-addr" -prune > /tmp/proxy_dirs.txt && \
    COUNT=$(wc -l < /tmp/proxy_dirs.txt) && \
    if [ "$COUNT" -eq 0 ]; then echo "Error: No proxy-addr instance found to patch."; exit 1; fi && \
    while IFS= read -r dir; do \
        rm -rf "$dir" && cp -a /tmp/patch-proxy/node_modules/proxy-addr "$dir"; \
    done < /tmp/proxy_dirs.txt && \
    rm -rf /tmp/patch-proxy /tmp/proxy_dirs.txt

# ★ tar を 7.5.19 に外科的置換 (CVE-2026-59873 対策)
RUN mkdir -p /tmp/patch-tar && cd /tmp/patch-tar && \
    npm init -y && \
    npm install tar@7.5.19 && \
    find /usr/src/app/server/node_modules -type d -name "tar" -prune > /tmp/tar_dirs.txt && \
    COUNT=$(wc -l < /tmp/tar_dirs.txt) && \
    echo "Found $COUNT tar instance(s) to patch." && \
    if [ "$COUNT" -eq 0 ]; then echo "Error: No tar instance found to patch."; exit 1; fi && \
    while IFS= read -r dir; do \
        echo "Patching: $dir"; \
        rm -rf "$dir" && cp -a /tmp/patch-tar/node_modules/tar "$dir"; \
    done < /tmp/tar_dirs.txt && \
    rm -rf /tmp/patch-tar /tmp/tar_dirs.txt

# tar バージョン検証（pnpm 配下の全インスタンス）
RUN node -e "\
const fs = require('fs');\
const path = require('path');\
const root = '/usr/src/app/server/node_modules';\
const found = [];\
function walk(dir) {\
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\
    if (entry.isSymbolicLink() || !entry.isDirectory()) continue;\
    const full = path.join(dir, entry.name);\
    if (entry.name === 'tar' && fs.existsSync(path.join(full, 'package.json'))) {\
      const pkg = JSON.parse(fs.readFileSync(path.join(full, 'package.json'), 'utf8'));\
      if (pkg.name === 'tar') found.push({ path: full, version: pkg.version });\
    } else {\
      walk(full);\
    }\
  }\
}\
walk(root);\
if (found.length === 0) { console.error('No tar packages found.'); process.exit(1); }\
for (const item of found) {\
  const v = item.version.split('.').map(Number);\
  if (v[0] < 7 || (v[0] === 7 && v[1] < 5) || (v[0] === 7 && v[1] === 5 && v[2] < 19)) {\
    console.error('Vulnerable tar version remains:', item.version, item.path);\
    process.exit(1);\
  }\
  console.log('Verified tar', item.version, 'at', item.path);\
}\
console.log('All tar instances are at least 7.5.19.');"

# ★ handlebars を 4.7.10 に外科的置換 (動的検出)
RUN mkdir -p /tmp/patch-handlebars && cd /tmp/patch-handlebars && \
    npm init -y && \
    npm install handlebars@4.7.10 && \
    echo "Searching for handlebars directories..." && \
    find /usr/src/app/server/node_modules -type d -name "handlebars" -prune > /tmp/handlebars_dirs.txt && \
    COUNT=$(wc -l < /tmp/handlebars_dirs.txt) && \
    echo "Found $COUNT handlebars instance(s) to patch." && \
    if [ "$COUNT" -eq 0 ]; then echo "Error: No handlebars instance found to patch."; exit 1; fi && \
    while IFS= read -r dir; do \
        echo "Patching: $dir"; \
        rm -rf "$dir" && \
        cp -a /tmp/patch-handlebars/node_modules/handlebars "$dir"; \
    done < /tmp/handlebars_dirs.txt && \
    rm -rf /tmp/patch-handlebars /tmp/handlebars_dirs.txt

# handlebars バージョン検証
RUN node -e "\
const fs = require('fs');\
const path = require('path');\
function findPackageJson(dir) {\
  let results = [];\
  const files = fs.readdirSync(dir, { withFileTypes: true });\
  for (const file of files) {\
    if (file.isSymbolicLink()) {\
      continue;\
    }\
    if (file.isDirectory() && file.name === 'handlebars') {\
      const pkgPath = path.join(dir, file.name, 'package.json');\
      if (fs.existsSync(pkgPath)) results.push(pkgPath);\
    } else if (file.isDirectory()) {\
      results = results.concat(findPackageJson(path.join(dir, file.name)));\
    }\
  }\
  return results;\
}\
const pkgs = findPackageJson('/usr/src/app/server/node_modules');\
if (pkgs.length === 0) { console.error('Error: No handlebars packages found.'); process.exit(1); }\
pkgs.forEach(pkg => {\
  const pkgDir = path.dirname(pkg);\
  const runtimeJsPath = path.join(pkgDir, 'dist/cjs/handlebars.runtime.js');\
  if (!fs.existsSync(runtimeJsPath)) {\
    console.error('Validation failed! dist/cjs/handlebars.runtime.js not found in ' + pkgDir);\
    process.exit(1);\
  }\
  const version = require(pkg).version;\
  console.log('Found handlebars version', version, 'at', pkg);\
  const v = version.split('.').map(Number);\
  if (v[0] < 4 || (v[0] === 4 && v[1] < 7) || (v[0] === 4 && v[1] === 7 && v[2] < 10)) {\
    console.error('Validation failed! Version is less than 4.7.10.');\
    process.exit(1);\
  }\
  try {\
    require(pkgDir);\
    console.log('Successfully required handlebars from ' + pkgDir);\
  } catch(e) {\
    console.error('Validation failed! Could not require handlebars from ' + pkgDir, e);\
    process.exit(1);\
  }\
});\
console.log('All handlebars instances validated successfully.');"

# OpenEXR パーサーの無効化（CVE-2026-34543 / CVE-2025-64181 等の対策）
RUN for p in /etc/ImageMagick-*/policy.xml; do \
      if [ -f "$p" ] && ! grep -q 'pattern="EXR"' "$p"; then \
        sed -i '/<policymap>/a\  <policy domain="coder" rights="none" pattern="EXR" />' "$p"; \
      fi; \
      if [ -f "$p" ] && ! grep -q 'rights="none" pattern="EXR"' "$p"; then \
        echo "⚠️ ImageMagick EXR policy not successfully applied in $p"; \
        exit 1; \
      fi; \
    done || true

# Validate ImageMagick Policy functionality
RUN if command -v identify >/dev/null 2>&1; then \
      identify -list policy | grep -i "EXR" | grep -i "None" || (echo "⚠️ EXR is not functionally disabled in ImageMagick!" && exit 1); \
    fi

# =========================
# Hardening Strategy 3: 権限昇格遮断
# =========================
RUN rm -f /bin/su /usr/bin/sudo || true

# =========================
# 実行ディレクトリ復元
# =========================
WORKDIR /usr/src/app
