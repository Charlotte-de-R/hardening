ARG APP_VERSION="release"

FROM ghcr.io/immich-app/immich-server:${APP_VERSION}

USER root

ARG APP_VERSION
LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.source="https://github.com/Charlotte-de-R/hardening"
LABEL org.opencontainers.image.description="Immich Server - Photo/Video Backup (hardened & CVE-reduced)"

ENV DEBIAN_FRONTEND=noninteractive

# =========================
# Hardening Strategy 1: OS更新 + 不要パッケージ削除
# =========================
RUN apt-get update && \
    apt-get dist-upgrade -y && \
    apt-get install -y --no-install-recommends \
        libexpat1 \
        zlib1g \
        libsqlite3-0 \
        openssl \
        libglib2.0-0 \
        perl \
        perl-base && \
    apt-get purge -y \
        perl-modules || true && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# =========================
# Hardening Strategy 2: protobufjs & proxy-addr 脆弱性の外科的置換
# =========================
WORKDIR /usr/src/app/server

RUN mkdir -p /tmp/patch && \
    cd /tmp/patch && \
    npm init -y && \
    npm install protobufjs@7.5.5 && \
    find /usr/src/app/server/node_modules -type d -name "protobufjs" -exec sh -c 'rm -rf "$1"/* && cp -a /tmp/patch/node_modules/protobufjs/* "$1/"' _ {} \; && \
    rm -rf /tmp/patch

# ★ proxy-addr を 2.0.8 (CVE-2026-90711 対策) に外科的置換
RUN mkdir -p /tmp/patch-proxy && cd /tmp/patch-proxy && \
    npm init -y && \
    npm install proxy-addr@2.0.8 && \
    find /usr/src/app/server/node_modules -type d -name "proxy-addr" -exec sh -c 'rm -rf "$1"/* && cp -a /tmp/patch-proxy/node_modules/proxy-addr/* "$1/"' _ {} \; && \
    rm -rf /tmp/patch-proxy

# OpenEXR パーサーの無効化（CVE-2026-34543 / CVE-2025-64181 等の対策）
RUN for p in /etc/ImageMagick-*/policy.xml; do \
      if [ -f "$p" ] && ! grep -q 'pattern="EXR"' "$p"; then \
        sed -i '/<policymap>/a\  <policy domain="coder" rights="none" pattern="EXR" />' "$p"; \
      fi; \
    done || true

# =========================
# Hardening Strategy 3: 権限昇格遮断
# =========================
RUN rm -f /bin/su /usr/bin/sudo || true

# =========================
# 実行ディレクトリ復元
# =========================
WORKDIR /usr/src/app
