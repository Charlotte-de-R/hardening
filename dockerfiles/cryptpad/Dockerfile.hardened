ARG APP_VERSION=2026.5.1
FROM node:24-alpine AS node-runtime

FROM cryptpad/cryptpad:version-${APP_VERSION}

USER root

ARG APP_VERSION

LABEL org.opencontainers.image.version="${APP_VERSION}"

# Update packages using the package manager provided by the upstream base image.
# CryptPad's base image is not guaranteed to be Alpine, so do not assume apk exists.
RUN set -eu; \
    if command -v apk >/dev/null 2>&1; then \
        apk update && \
        apk upgrade --no-cache && \
        rm -rf /var/cache/apk/*; \
    elif command -v apt-get >/dev/null 2>&1; then \
        export DEBIAN_FRONTEND=noninteractive; \
        apt-get update -o Acquire::Retries=3 && \
        apt-get upgrade -y -o Acquire::Retries=3 && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "ERROR: No supported package manager found in CryptPad base image." >&2; \
        exit 1; \
    fi

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

WORKDIR /cryptpad

RUN rm -f /bin/su /usr/bin/sudo || true

USER 4001
