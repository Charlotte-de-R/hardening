ARG APP_VERSION="latest"

FROM nextcloud:${APP_VERSION}

USER root

ARG APP_VERSION
LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.source="https://github.com/Charlotte-de-R/hardening"
LABEL org.opencontainers.image.description="Nextcloud (safe hardened)"

ENV DEBIAN_FRONTEND=noninteractive

# --- 最小限のみ（絶対安全ライン） ---
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*


# --- 軽いハードニングのみ ---
RUN rm -f /usr/bin/sudo || true

# OpenEXR パーサーの無効化（CVE-2026-34543 / CVE-2025-64181 等の対策）
RUN for p in /etc/ImageMagick-*/policy.xml; do \
      if [ -f "$p" ] && ! grep -q 'pattern="EXR"' "$p"; then \
        sed -i '/<policymap>/a\  <policy domain="coder" rights="none" pattern="EXR" />' "$p"; \
      fi; \
    done || true

WORKDIR /var/www/html
