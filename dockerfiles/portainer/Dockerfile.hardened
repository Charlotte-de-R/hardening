ARG APP_VERSION="latest"

# Stage 0: 公式イメージからUIと既定の実行環境を取得
FROM portainer/portainer-ce:${APP_VERSION} AS base

# Stage 1: コアバイナリを再ビルド
FROM golang:alpine AS builder
ARG APP_VERSION
ARG TARGETARCH=amd64

RUN apk add --no-cache git ca-certificates

RUN if [ "${APP_VERSION}" = "latest" ]; then \
        git clone --depth 1 https://github.com/portainer/portainer.git /go/src/portainer; \
    else \
        git clone --depth 1 --branch "${APP_VERSION}" https://github.com/portainer/portainer.git /go/src/portainer; \
    fi

WORKDIR /go/src/portainer

RUN cd api && \
    go mod tidy && \
    CGO_ENABLED=0 GOOS=linux GOARCH="${TARGETARCH}" go build \
      -trimpath \
      --installsuffix cgo \
      --ldflags "-s -w" \
      -o /go/bin/portainer \
      ./cmd/portainer/

FROM alpine AS patcher
RUN apk add --no-cache curl nodejs npm

COPY --from=base /public /app/public

RUN set -eu; \
    mkdir -p /tmp/patch && cd /tmp/patch && \
    npm init -y >/dev/null && \
    npm install --no-audit --no-fund --ignore-scripts lodash@4.17.21 && \
    find /app/public -type d -name lodash -prune -print > /tmp/lodash-targets && \
    if [ ! -s /tmp/lodash-targets ]; then \
      echo "WARNING: no standalone lodash directory found under /app/public; no filesystem replacement was applied. Trivy must determine whether a bundled dependency remains vulnerable." >&2; \
    else \
      while IFS= read -r target; do \
        case "$target" in /app/public/*) ;; *) echo "ERROR: unexpected lodash path: $target" >&2; exit 1 ;; esac; \
        if [ ! -d "$target" ] || [ -L "$target" ]; then echo "ERROR: invalid lodash target: $target" >&2; exit 1; fi; \
        echo "Replacing lodash directory: $target"; \
        rm -rf "$target"; \
        cp -a /tmp/patch/node_modules/lodash "$target"; \
        node -e 'const p=require(process.argv[1]); if(p.version !== "4.17.21") process.exit(1)' "$target/package.json"; \
      done < /tmp/lodash-targets; \
    fi; \
    rm -f /tmp/lodash-targets && rm -rf /tmp/patch

ARG DOCKER_CLI_VERSION
RUN curl -fsSLO "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" && \
    tar -xzf "docker-${DOCKER_CLI_VERSION}.tgz" && \
    mkdir -p /app/bin && \
    cp docker/docker /app/bin/docker

# Stage 3: 最終イメージ
FROM portainer/portainer-ce:${APP_VERSION}

ARG APP_VERSION
ARG TARGETARCH=amd64
ARG DOCKER_CLI_VERSION

LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.docker-cli-version="${DOCKER_CLI_VERSION}"
LABEL org.opencontainers.image.source="https://github.com/Charlotte-de-R/hardening"
LABEL org.opencontainers.image.description="Portainer CE (hardened build)"

COPY --from=builder /go/bin/portainer /portainer
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=patcher /app/public /public
COPY --from=patcher /app/bin/docker /docker
