ARG APP_VERSION="release"

FROM golang:alpine AS builder
ARG APP_VERSION

# Recompile gosu to eliminate Go CVEs
RUN apk add --no-cache git && \
    CGO_ENABLED=0 go install github.com/tianon/gosu@latest

FROM ghcr.io/immich-app/immich-machine-learning:${APP_VERSION}
USER root

ARG APP_VERSION
LABEL org.opencontainers.image.version="${APP_VERSION}"

# COPY the freshly built gosu binary and forcibly map it to all known paths
COPY --from=builder /go/bin/gosu /usr/local/bin/gosu
RUN ln -sf /usr/local/bin/gosu /usr/bin/gosu && \
    ln -sf /usr/local/bin/gosu /usr/sbin/gosu && \
    ln -sf /usr/local/bin/gosu /sbin/gosu

# Hardening:
# --- COMMON HARDENING START (DO NOT EDIT MANUALLY) ---
ARG CACHEBUST=1
RUN echo "Cache bust: $CACHEBUST" && \
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH" && \
    if command -v apk >/dev/null 2>&1; then \
        echo "⛰️ Alpine Linux detected" && \
        (apk update || echo "⚠️ apk update failed") && \
        (apk upgrade --no-cache || echo "⚠️ apk upgrade failed") && \
        (apk add --no-cache --upgrade zlib sqlite-libs libcrypto3 libssl3 || echo "⚠️ Library upgrade failed") && \
        (apk del --no-cache nano vim git || true) && \
        rm -rf /var/cache/apk/* /usr/share/man/* || true; \
    elif command -v apt-get >/dev/null 2>&1; then \
        echo "🌀 Debian/Ubuntu detected" && \
        export DEBIAN_FRONTEND=noninteractive && \
        (apt-get update -o Acquire::Retries=3 || echo "⚠️ apt-get update failed") && \
        (apt-get upgrade -y -o Acquire::Retries=3 || echo "⚠️ apt-get upgrade failed") && \
        echo "🔒 Installing critical security updates from Debian sid..." && \
        (echo "deb http://deb.debian.org/debian sid main" > /etc/apt/sources.list.d/sid.list && \
         apt-get update -o Acquire::Retries=3 || echo "⚠️ sid update failed") && \
        (apt-get install -y --no-install-recommends -t sid \
            libc6 \
            zlib1g \
            libsqlite3-0 \
            openssl \
            ca-certificates 2>/dev/null || \
         echo "⚠️ sid packages failed, using default versions") && \
        (apt-get purge -y --auto-remove vim nano git telnet ftp man-db doc-debian 2>/dev/null || true) && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/share/doc/* /usr/share/man/* /etc/apt/sources.list.d/sid.list || true; \
    else \
        echo "⚠️ No supported package manager. Skipping." && true; \
    fi && \
    echo "📦 Upgrading Language Packages for Vulnerability Remediation..." && \
    (if command -v npm >/dev/null 2>&1; then \
        if [ -d /usr/src/app ] && [ -f /usr/src/app/package.json ]; then \
            cd /usr/src/app && npm update tar glob systeminformation || true; \
        else \
            npm install -g tar glob systeminformation || true; \
        fi; \
    fi) && \
    (if command -v pip >/dev/null 2>&1 || command -v pip3 >/dev/null 2>&1; then \
        PIP_CMD=$(command -v pip || command -v pip3); \
        $PIP_CMD install --upgrade --no-cache-dir wheel urllib3 python-multipart jaraco.context || true; \
    fi) && \
    echo "🧹 Optimizing Docker layers for Trivy scanning..." && \
    (find /var/lib/dpkg -type f -name "*-old" -delete 2>/dev/null || true) && \
    (find /var/lib/apt/lists -type f -delete 2>/dev/null || true) && \
    (rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* /var/cache/debconf/* 2>/dev/null || true)
# --- COMMON HARDENING END ---

# システム pip を 26.3 に更新する (アラート #10676 の根本対応)。
# Trivy の検出元はアプリの venv ではなく、システム pip が同梱する
# vendored certifi 2026.06.17 (GHSA-6q48-6c7w-9gw2)。
# pip 26.3 は vendored certifi 2026.10.23 を同梱する。
# 初回取得で旧 pip の TLS を使わないよう、pip は使わず OS の CA ストアで
# 検証する経路で wheel を取得し、固定 SHA-256 を照合してから導入する。
RUN /usr/local/bin/python3 -c "import urllib.request; urllib.request.urlretrieve('https://files.pythonhosted.org/packages/07/25/ee8c38ae72d66b844ce8eb9711ba905dba21ca1a8a0c960057c41cd23337/pip-26.3-py3-none-any.whl', '/tmp/pip-26.3-py3-none-any.whl')" && \
    echo "f3b60b20ffaadd4415ed7957212a38ac63fa4c5fa375bd0f4a797777940fad13  /tmp/pip-26.3-py3-none-any.whl" | sha256sum -c - && \
    pip install --no-cache-dir /tmp/pip-26.3-py3-none-any.whl && \
    rm -f /tmp/pip-26.3-py3-none-any.whl && \
    pip --version | grep -q "pip 26.3 from" && \
    /usr/local/bin/python3 -c 'from pip._vendor import certifi; print("pip vendored certifi:", certifi.__version__); assert certifi.__version__ >= "2026.10.18", certifi.__version__'

# ensurepip 同梱 wheel の差し替え (アラート #10676 の残件)。
# 上の pip 更新では ensurepip の _bundled に残る pip 26.2.1 の wheel
# (vendored certifi 2026.06.17) は置き換わらず、Trivy の検出が残る。
# pip は wheel のファイル名と内部メタデータのバージョン一致を要求するため、
# ファイル名を維持したままの中身だけの差し替えでは ensurepip が壊れる
# (inconsistent version で弾かれる)。そのため wheel は正しい名前
# (pip-26.3-py3-none-any.whl) で配置し、ensurepip の _PIP_VERSION も
# 合わせて 26.3 に更新して機能を維持する。
# 取得は pip を使わず OS の CA ストアで検証し、固定 SHA-256 を照合する。
# 差し替え後は ensurepip 経由 (venv 作成) で入る pip が 26.3 になることと、
# その vendored certifi が修正版であることを実機で検証する。
RUN set -eux; \
    BUNDLED_DIR=/usr/local/lib/python3.13/ensurepip/_bundled; \
    ENSUREPIP_INIT=/usr/local/lib/python3.13/ensurepip/__init__.py; \
    set -- "$BUNDLED_DIR"/pip-*.whl; \
    [ "$#" -eq 1 ] && [ -f "$1" ]; \
    [ "$(basename "$1")" = "pip-26.2.1-py3-none-any.whl" ]; \
    grep -q '^_PIP_VERSION = "26.2.1"$' "$ENSUREPIP_INIT"; \
    /usr/local/bin/python3 -c "import urllib.request; urllib.request.urlretrieve('https://files.pythonhosted.org/packages/07/25/ee8c38ae72d66b844ce8eb9711ba905dba21ca1a8a0c960057c41cd23337/pip-26.3-py3-none-any.whl', '/tmp/pip-26.3-py3-none-any.whl')"; \
    echo "f3b60b20ffaadd4415ed7957212a38ac63fa4c5fa375bd0f4a797777940fad13  /tmp/pip-26.3-py3-none-any.whl" | sha256sum -c -; \
    cp /tmp/pip-26.3-py3-none-any.whl "$BUNDLED_DIR/pip-26.3-py3-none-any.whl"; \
    rm -f "$1" /tmp/pip-26.3-py3-none-any.whl; \
    sed -i 's/^_PIP_VERSION = "26.2.1"$/_PIP_VERSION = "26.3"/' "$ENSUREPIP_INIT"; \
    grep -q '^_PIP_VERSION = "26.3"$' "$ENSUREPIP_INIT"; \
    /usr/local/bin/python3 -m ensurepip --version | grep -q "pip 26.3"; \
    BUNDLED_PATH="$BUNDLED_DIR/pip-26.3-py3-none-any.whl" /usr/local/bin/python3 -c 'import os, zipfile, re; z = zipfile.ZipFile(os.environ["BUNDLED_PATH"]); t = z.read("pip/_vendor/certifi/__init__.py").decode(); v = re.search(r"__version__\s*=\s*.([0-9.]+).", t).group(1); print("bundled wheel vendored certifi:", v); assert v >= "2026.10.18", v'; \
    rm -rf /tmp/ensurepip-verify; \
    /usr/local/bin/python3 -m venv /tmp/ensurepip-verify; \
    /tmp/ensurepip-verify/bin/pip --version | grep -q "pip 26.3 from"; \
    /tmp/ensurepip-verify/bin/python -c 'from pip._vendor import certifi; print("ensurepip-installed pip vendored certifi:", certifi.__version__); assert certifi.__version__ >= "2026.10.18", certifi.__version__'; \
    rm -rf /tmp/ensurepip-verify

# The upstream image uses a pip-free runtime venv. Install packages with
# the image's available pip and --prefix so files land in /opt/venv.
RUN rm -rf /opt/venv/lib/python*/site-packages/anyio* && \
    pip install --prefix=/opt/venv --no-cache-dir "anyio>=4.14.2"

# Remove obsolete Pillow metadata and force a clean package installation.
# Validate that exactly one Pillow distribution record remains and matches
# the module imported by Immich ML's runtime Python.
RUN rm -rf /opt/venv/lib/python*/site-packages/Pillow-*.dist-info \
           /opt/venv/lib/python*/site-packages/pillow-*.dist-info \
           /opt/venv/lib/python*/site-packages/certifi-*.dist-info \
           /opt/venv/lib/python*/site-packages/certifi-*.egg-info && \
    pip install --prefix=/opt/venv --no-cache-dir --force-reinstall \
        "Pillow>=13.0.0" \
        "certifi>=2026.10.23" && \
    python -c 'import sys, certifi; from PIL import Image; from importlib.metadata import distributions, version; records=[(d.version,str(d._path)) for d in distributions() if (d.metadata.get("Name") or "").lower()=="pillow"]; certifi_records=[(d.version,str(d._path)) for d in distributions() if (d.metadata.get("Name") or "").lower()=="certifi"]; print("Python:",sys.executable); print("Pillow import:",Image.__version__); print("Pillow records:",records); print("certifi import:",certifi.__version__); print("certifi records:",certifi_records); print("CA bundle:",certifi.where()); assert len(records)==1,records; assert records[0][0]==Image.__version__; assert tuple(map(int,Image.__version__.split(".")[:2])) >= (13,0); assert len(certifi_records)==1,certifi_records; assert certifi_records[0][0]==certifi.__version__; assert certifi.__version__ >= "2026.10.23"'
