ARG APP_VERSION="release"

FROM golang:alpine AS builder
ARG APP_VERSION

# Recompile gosu to eliminate Go CVEs
RUN apk add --no-cache git && \
    CGO_ENABLED=0 go install github.com/tianon/gosu@latest

FROM ghcr.io/immich-app/immich-machine-learning:${APP_VERSION}
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
USER root

ARG APP_VERSION
LABEL org.opencontainers.image.version="${APP_VERSION}"

# COPY the freshly built gosu binary and forcibly map it to all known paths
COPY --from=builder /go/bin/gosu /usr/local/bin/gosu
RUN ln -sf /usr/local/bin/gosu /usr/bin/gosu && \
    ln -sf /usr/local/bin/gosu /usr/sbin/gosu && \
    ln -sf /usr/local/bin/gosu /sbin/gosu

# Hardening:
# --- COMMON HARDENING START (DO NOT EDIT MANUALLY) ---
ARG CACHEBUST=1
RUN echo "Cache bust: $CACHEBUST" && \
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH" && \
    if command -v apk >/dev/null 2>&1; then \
        echo "⛰️ Alpine Linux detected" && \
        (apk update || echo "⚠️ apk update failed") && \
        (apk upgrade --no-cache || echo "⚠️ apk upgrade failed") && \
        (apk add --no-cache --upgrade zlib sqlite-libs libcrypto3 libssl3 || echo "⚠️ Library upgrade failed") && \
        (apk del --no-cache nano vim git || true) && \
        rm -rf /var/cache/apk/* /usr/share/man/* || true; \
    elif command -v apt-get >/dev/null 2>&1; then \
        echo "🌀 Debian/Ubuntu detected" && \
        export DEBIAN_FRONTEND=noninteractive && \
        (apt-get update -o Acquire::Retries=3 || echo "⚠️ apt-get update failed") && \
        (apt-get upgrade -y -o Acquire::Retries=3 || echo "⚠️ apt-get upgrade failed") && \
        echo "🔒 Installing critical security updates from Debian sid..." && \
        (echo "deb http://deb.debian.org/debian sid main" > /etc/apt/sources.list.d/sid.list && \
         apt-get update -o Acquire::Retries=3 || echo "⚠️ sid update failed") && \
        (apt-get install -y --no-install-recommends -t sid \
            libc6 \
            zlib1g \
            libsqlite3-0 \
            openssl \
            ca-certificates 2>/dev/null || \
         echo "⚠️ sid packages failed, using default versions") && \
        (apt-get purge -y --auto-remove vim nano git telnet ftp man-db doc-debian 2>/dev/null || true) && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/share/doc/* /usr/share/man/* /etc/apt/sources.list.d/sid.list || true; \
    else \
        echo "⚠️ No supported package manager. Skipping." && true; \
    fi && \
    echo "📦 Upgrading Language Packages for Vulnerability Remediation..." && \
    (if command -v npm >/dev/null 2>&1; then \
        if [ -d /usr/src/app ] && [ -f /usr/src/app/package.json ]; then \
            cd /usr/src/app && npm update tar glob systeminformation || true; \
        else \
            npm install -g tar glob systeminformation || true; \
        fi; \
    fi) && \
    (if command -v pip >/dev/null 2>&1 || command -v pip3 >/dev/null 2>&1; then \
        PIP_CMD=$(command -v pip || command -v pip3); \
        $PIP_CMD install --upgrade --no-cache-dir wheel urllib3 python-multipart jaraco.context || true; \
    fi) && \
    echo "🧹 Optimizing Docker layers for Trivy scanning..." && \
    (find /var/lib/dpkg -type f -name "*-old" -delete 2>/dev/null || true) && \
    (find /var/lib/apt/lists -type f -delete 2>/dev/null || true) && \
    (rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* /var/cache/debconf/* 2>/dev/null || true)
# --- COMMON HARDENING END ---

# The upstream image uses a pip-free runtime venv. Install packages with
# the image's available pip and --prefix so files land in /opt/venv.
RUN rm -rf /opt/venv/lib/python*/site-packages/anyio* && \
    VIRTUAL_ENV=/opt/venv uv pip install "anyio>=4.14.2"

# Remove obsolete Pillow metadata and force a clean package installation.
# Validate that exactly one Pillow distribution record remains and matches
# the module imported by Immich ML's runtime Python.
RUN rm -rf /opt/venv/lib/python*/site-packages/Pillow-*.dist-info \
           /opt/venv/lib/python*/site-packages/pillow-*.dist-info \
           /opt/venv/lib/python*/site-packages/certifi-*.dist-info \
           /opt/venv/lib/python*/site-packages/certifi-*.egg-info && \
    VIRTUAL_ENV=/opt/venv uv pip install --reinstall \
        "Pillow>=13.0.0" \
        "certifi>=2026.10.23" && \
    /opt/venv/bin/python -c 'import sys; from importlib.metadata import distributions, version; records=[(d.version,str(d._path)) for d in distributions() if (d.metadata.get("Name") or "").lower()=="pillow"]; certifi_records=[(d.version,str(d._path)) for d in distributions() if (d.metadata.get("Name") or "").lower()=="certifi"]; print("Python:",sys.executable); print("Pillow version:",version("Pillow")); print("Pillow records:",records); print("certifi version:",version("certifi")); print("certifi records:",certifi_records); assert len(records)==1,records; assert records[0][0]==version("Pillow"); assert tuple(map(int,version("Pillow").split(".")[:2])) >= (13,0); assert len(certifi_records)==1,certifi_records; assert certifi_records[0][0]==version("certifi"); assert version("certifi") >= "2026.10.23"'
